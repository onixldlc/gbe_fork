# Linux build-env image  ->  gbe-env:linux-<date>
#
# FROM the gbe-deps source image (pinned third-party sources + tools), this
# stage COMPILES every dep once — release config, 32 + 64 bit, overlay excluded
# — so the emu build no longer pays the ~40min dependency build on every run.
#
# Layout shipped:
#   /opt/gbe_deps/third-party        (sources + premake/cmake/7za, inherited)
#   /opt/gbe_build/build/deps/linux  (the COMPILED deps the emu links against)
#
# Built by build-env-linux.yml as a standalone image (no nested workflows).
# Rebuild when premake5-deps.lua or this file change; after a Dockerfile.deps
# (versions) change, rebuild gbe-deps first, then trigger this.
ARG DEPS_IMAGE=ghcr.io/onixldlc/gbe-deps:latest
FROM ${DEPS_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

# toolchain to compile the deps (and, on the runner later, the emu)
RUN dpkg --add-architecture i386 \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential gcc-multilib g++-multilib \
      libglx-dev libgl-dev libx11-dev:i386 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/gbe_build
COPY premake5-deps.lua ./

# premake5-deps.lua resolves third-party/ + its tools relative to the cwd, and
# writes the compiled tree to build/deps/linux/gmake.
RUN cp -rT /opt/gbe_deps/third-party third-party \
 && chmod +x third-party/common/linux/premake/premake5 \
 && CMAKE_GENERATOR="Unix Makefiles" \
    third-party/common/linux/premake/premake5 \
      --file=premake5-deps.lua --disableoverlay \
      --all-ext --all-build --64-build --32-build \
      --verbose --clean --os=linux gmake \
 && rm -rf third-party   # only the compiled build/deps tree is kept; the
                         # runner re-seeds sources from the inherited gbe-deps layer
